# Espace Katioka — production settings for docker compose (copy to .env.production, never share it).
APP_NAME="Espace Katioka"
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
# The VPS address for now (http://203.0.113.10); https://your-domain once you have one.
APP_URL=http://CHANGE-ME
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# ":80" = HTTP on the VPS IP. With a domain: SERVER_NAME=hotel.example.ci (automatic HTTPS),
# then APP_URL=https://hotel.example.ci and SESSION_SECURE_COOKIE=true.
SERVER_NAME=":80"
SESSION_SECURE_COOKIE=false

# Database (shared by the db container and the app). Use a long random password.
POSTGRES_DB=espace_katioka
POSTGRES_USER=katioka
POSTGRES_PASSWORD=CHANGE-ME

# Default manager account, created at the first start only (empty database), to be changed at
# first login. Leave ADMIN_PASSWORD empty to get a random one, shown once in: docker compose logs app
ADMIN_EMAIL=admin@espace-katioka.local
ADMIN_PASSWORD=

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
